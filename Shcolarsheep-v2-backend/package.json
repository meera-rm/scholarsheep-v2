    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "google-auth-library": "^9.14.0",
    "jsonwebtoken": "^9.0.1",
    "morgan": "^1.10.0",
    "pg-promise": "^11.9.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
