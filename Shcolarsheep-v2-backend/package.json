{
  "name": "scholarsheep-v2-backend",
  "version": "2.0.0",
  "description": "ScholarSheep v2 Backend — Express + PostgreSQL + JWT",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
